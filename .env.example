# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database & Auth Configuration
DATABASE_URL="file:./data/database.json"
AUTH_SECRET="super-secret-recruitment-ai-key"

# AI & Image Generation Provider Configuration
# Options for IMAGE_PROVIDER: gemini | openai | imagen | flux | stability | demo
IMAGE_PROVIDER="gemini"
IMAGE_MODEL="gemini-3.1-flash-lite-image"
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""

# Storage Configuration
STORAGE_PROVIDER="local"
STORAGE_BUCKET="recruitment-posters"

# Demo Mode Fallback (true | false)
DEMO_MODE="true"
